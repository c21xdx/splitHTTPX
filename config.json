{
	"log": {
		"loglevel": "warning"
	},
	"routing": {
		"domainStrategy": "AsIs",
		"rules": [{
			"type": "field",
			"ip": [
				"geoip:private"
			],
			"outboundTag": "block"
		}]
	},
	"inbounds": [{
		"listen": "0.0.0.0",
		"port": 8080,
		"protocol": "vless",
		"settings": {
			"clients": [{
				"id": "0cf85927-2c71-4e87-9df3-b1eb7d5a9e1b"
			}],
			"decryption": "none"
		},
		"streamSettings": {
			"network": "splithttp",
			"splithttpSettings": {
				"path": "/splitx"
			}
		},
		"sniffing": {
			"enabled": true,
			"destOverride": [
				"http",
				"tls",
				"quic"
			]
		}
	}],
	"outbounds": [{
			"protocol": "freedom",
			"tag": "direct"
		},
		{
			"protocol": "blackhole",
			"tag": "block"
		}
	]
}
